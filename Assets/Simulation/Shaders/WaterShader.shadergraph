{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "f0a1736d72c0406299e626a8d7f9ff31",
    "m_Title": "Scene Depth",
    "m_Content": "\nScene Depth returns a value between 0 and 1 representing how far an opaque object is from the camera. It casts an imaginary ray from the camera through each pixel — if it hits an opaque object, it returns distance to object / camera far clip. If nothing is hit, it returns 1.\nIn the water shader, this tells us what's under the water surface at each pixel, which lets us calculate how deep the water is at that point.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1931.0,
        "y": 29.0,
        "width": 325.0,
        "height": 170.0
    },
    "m_Group": {
        "m_Id": "149995288ac94fb8a605044d724aef14"
    }
}

